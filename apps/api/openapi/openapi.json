  "components" : {
    "schemas" : {
      "AdminUserResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "email" : {
            "type" : "string"
          },
          "fullName" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lockedUntil" : {
            "type" : "string",
            "format" : "date-time"
          },
          "mfaEnabled" : {
            "type" : "boolean"
          },
          "mustChangePassword" : {
            "type" : "boolean"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "SUPER_ADMIN", "OPS", "FLEET_MANAGER", "ACCOUNTANT", "STATION_MANAGER" ]
          },
          "scope" : {
            "$ref" : "#/components/schemas/ScopeResponse"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "SUSPENDED", "DEACTIVATED" ]
          }
        },
        "required" : [ "createdAt", "email", "fullName", "id", "mfaEnabled", "mustChangePassword", "role", "scope", "status" ]
      },
      "ApiError" : {
        "type" : "object",
        "description" : "The shape of every refusal and failure",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Stable reason; clients pick their wording from this"
          },
          "field" : {
            "type" : "string",
            "description" : "The single input this is about, when there is exactly one"
          },
          "fields" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldIssue"
            }
          },
          "message" : {
            "type" : "string",
            "description" : "English fallback for logs and tools; not UI copy"
          },
          "params" : {
            "type" : "object",
            "additionalProperties" : { },
            "description" : "Values a translated sentence needs, such as limits"
          },
          "requestId" : {
            "type" : "string",
            "description" : "Matches the X-Request-Id header and the server log"
          },
          "retryAfterSeconds" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "With 429: seconds until the request would be accepted"
          },
          "retryable" : {
            "type" : "boolean",
            "description" : "Whether sending the same request again can succeed"
          },
          "statusCode" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "code", "message", "retryable", "statusCode" ]
      },
      "AuditEntry" : {
        "type" : "object",
        "properties" : {
          "action" : {
            "type" : "string"
          },
          "actorId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "actorRole" : {
            "type" : "string"
          },
          "entityId" : {
            "type" : "string",
            "format" : "uuid"
          },
